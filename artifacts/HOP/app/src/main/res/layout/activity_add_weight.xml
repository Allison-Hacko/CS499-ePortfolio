<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFEAF1"
    android:fillViewport="true"
    tools:context=".AddWeightActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Header -->
        <TextView
            android:id="@+id/textAddWeightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Weight"
            android:textColor="#352D30"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textAddWeightSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Record your progress and keep HOP moving."
            android:textColor="#75686D"
            android:textSize="14sp" />

        <!-- Weight Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEIGHT"
                android:textColor="#75686D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editWeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:hint="Enter your weight"
                android:inputType="numberDecimal"
                android:minHeight="56dp"
                android:padding="14dp"
                android:textColor="#352D30"
                android:textColorHint="#9B8B91" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Weight is recorded in pounds (lb)."
                android:textColor="#75686D"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Date Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/login_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE"
                android:textColor="#75686D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:hint="MM/DD/YYYY"
                android:inputType="date"
                android:minHeight="56dp"
                android:padding="14dp"
                android:textColor="#352D30"
                android:textColorHint="#9B8B91" />

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/buttonSaveWeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#D96F91"
            android:text="SAVE WEIGHT ENTRY"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <!-- Cancel Button -->
        <Button
            android:id="@+id/buttonCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Cancel"
            android:textColor="#B85C7B" />
    </LinearLayout>

</ScrollView>