{
  "info": {
    "name": "Travlr API Tests",
    "description": "API tests for public trip retrieval, registration, login, authorization, and optional administrator trip CRUD. Set baseUrl to the running Express server. Run requests in order. For admin tests, provide a valid administrator JWT in adminToken.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "TravlrTestPass123!" },
    { "key": "userToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "testTripCode", "value": "" }
  ],
  "item": [
    {
      "name": "1. Public API",
      "item": [
        {
          "name": "Get all trips",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/trips"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Public trip list responds successfully', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });",
                  "pm.test('Response is JSON', function () { pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Registration and Login",
      "item": [
        {
          "name": "Register a test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('email')) { pm.collectionVariables.set('email', 'travlr.test.' + Date.now() + '@example.com'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration succeeds or user already exists', function () { pm.expect(pm.response.code).to.be.oneOf([201, 200, 409]); });",
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set('userToken', data.token);",
                  "}",
                  "pm.test('Successful registration returns a token', function () { if ([200, 201].includes(pm.response.code)) pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Travlr API Test\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/register"
          }
        },
        {
          "name": "Log in as test user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) pm.collectionVariables.set('userToken', data.token);",
                  "}",
                  "pm.test('Login returns a JWT', function () { pm.expect(pm.response.json().token).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/login"
          }
        }
      ]
    },
    {
      "name": "3. Authorization Checks",
      "item": [
        {
          "name": "Reject trip creation without a token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unauthenticated trip creation is rejected', function () { pm.expect(pm.response.code).to.eql(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"UNAUTHORIZED-TEST\",\n  \"name\": \"Unauthorized test trip\"\n}"
            },
            "url": "{{baseUrl}}/trips"
          }
        },
        {
          "name": "Reject regular user trip creation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Regular user cannot create administrator trips', function () { pm.expect(pm.response.code).to.eql(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"REGULAR-USER-TEST\",\n  \"name\": \"Regular user test trip\"\n}"
            },
            "url": "{{baseUrl}}/trips"
          }
        }
      ]
    },
    {
      "name": "4. Administrator CRUD (requires adminToken)",
      "description": "Before running this folder, set the adminToken collection variable to a valid JWT belonging to an administrator. Run requests in order.",
      "item": [
        {
          "name": "Create test trip",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testTripCode', 'PT' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrator can create a trip', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{testTripCode}}\",\n  \"name\": \"Postman Test Trip\",\n  \"length\": 7,\n  \"start\": \"2026-11-01\",\n  \"resort\": \"Test Resort\",\n  \"perPerson\": 599,\n  \"image\": \"mountain.png\",\n  \"description\": \"Trip created by the Travlr API test collection.\"\n}"
            },
            "url": "{{baseUrl}}/trips"
          }
        },
        {
          "name": "Update test trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrator can update a trip', function () { pm.expect(pm.response.code).to.eql(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{testTripCode}}\",\n  \"name\": \"Updated Postman Test Trip\",\n  \"length\": 8,\n  \"start\": \"2026-11-02\",\n  \"resort\": \"Updated Test Resort\",\n  \"perPerson\": 649,\n  \"image\": \"mountain.png\",\n  \"description\": \"Trip updated by the Travlr API test collection.\"\n}"
            },
            "url": "{{baseUrl}}/trips/{{testTripCode}}"
          }
        },
        {
          "name": "Delete test trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Administrator can delete a trip', function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/trips/{{testTripCode}}"
          }
        }
      ]
    }
  ]
}
